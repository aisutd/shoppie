# backend settings load from root .env, then existing scraper/.env; environment wins
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# keep disabled by default; CLI --allow-gemini or dashboard checkbox opts in per action
SHOPPIE_ALLOW_GEMINI=0
# enable only retailer page access your team is permitted to use
SHOPPIE_PAGE_RETAILERS=
# existing backend credentials are also read from scraper/.env; never duplicate real keys
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SCHEMA=public
# demo by default; options: demo, live (local collected data), supabase (read only)
SHOPPIE_API_SOURCE=demo
# only after mentor inspection/approval of a development or test project
SHOPPIE_DATABASE_URL=
SHOPPIE_DATABASE_ENV=
SHOPPIE_SCHEMA_APPROVED=0
SHOPPIE_DATABASE_WRITES=0
